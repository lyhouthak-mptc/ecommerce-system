### User Service API tests (IntelliJ HTTP Client)
### Run the requests from top to bottom: each one saves values that the next ones use.

@baseUrl = http://localhost:55053/api/users
@keycloakUrl = http://localhost:8888/realms/ecommerce/protocol/openid-connect/token

### 1. Get an access token from Keycloak (needed for every endpoint except create)
POST {{keycloakUrl}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=ecommerce-admin-client&client_secret=YmFOlmKfkt9GuJxMPNZfV5OLfeVYyk4S

> {% client.global.set("token", response.body.access_token); %}

### 2. Create user (public) - roleName accepts several roles separated by ","
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "sokdara",
  "email": "sokdara@gmail.com",
  "roleId": "1",
  "familyName": "Sok",
  "givenName": "Dara",
  "password": "Qwer@1234",
  "confirmedPassword": "Qwer@1234",
  "roleName": "USER,CUSTOMER"
}

> {% client.global.set("userId", response.body.id); %}

### 3. Create a second user with another role
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "chanthy",
  "email": "chanthy@gmail.com",
  "roleId": "2",
  "familyName": "Chan",
  "givenName": "Thy",
  "password": "Qwer@1234",
  "confirmedPassword": "Qwer@1234",
  "roleName": "STAFF"
}

> {% client.global.set("userId2", response.body.id); %}

### 4. Get all users
GET {{baseUrl}}
Authorization: Bearer {{token}}

### 5. Get users by role name
GET {{baseUrl}}/roles/CUSTOMER
Authorization: Bearer {{token}}

### 6. Get user by id
GET {{baseUrl}}/{{userId}}
Authorization: Bearer {{token}}

### 7. Get user by username
GET {{baseUrl}}/username/sokdara
Authorization: Bearer {{token}}

### 8. Update user (send only the fields you want to change)
PATCH {{baseUrl}}/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "sokdara.new@gmail.com",
  "familyName": "Sok",
  "givenName": "Dara Updated",
  "gender": "Male",
  "birthday": "2000-01-15",
  "mobilePhone": "012345678",
  "address": "Phnom Penh, Cambodia"
}

### 9. Update only one field
PATCH {{baseUrl}}/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": "Siem Reap, Cambodia"
}

### 10. Delete users
DELETE {{baseUrl}}/{{userId}}
Authorization: Bearer {{token}}

###
DELETE {{baseUrl}}/{{userId2}}
Authorization: Bearer {{token}}


### ===== Error cases =====

### 400 - password does not match
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "baduser",
  "email": "baduser@gmail.com",
  "roleId": "1",
  "familyName": "Bad",
  "givenName": "User",
  "password": "Qwer@1234",
  "confirmedPassword": "different",
  "roleName": "USER"
}

### 400 - validation failed (blank fields, bad email)
POST {{baseUrl}}
Content-Type: application/json

{
  "username": "",
  "email": "not-an-email",
  "roleId": "",
  "familyName": "",
  "givenName": "",
  "password": "",
  "confirmedPassword": "",
  "roleName": ""
}

### 404 - user id not found
GET {{baseUrl}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

### 404 - username not found
GET {{baseUrl}}/username/nobody
Authorization: Bearer {{token}}

### 404 - role not found
GET {{baseUrl}}/roles/NOT_A_ROLE
Authorization: Bearer {{token}}

### 401 - no token
GET {{baseUrl}}
